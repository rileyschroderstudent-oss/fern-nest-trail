{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fnt-api",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fnt-usage",
      // Placeholder until `wrangler d1 create fnt-usage` prints the real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Production values. Local development overrides them in .dev.vars.
  "vars": {
    "ALLOWED_ORIGINS": "https://rileyschroderstudent-oss.github.io",
    "MODEL": "claude-haiku-5-5",
    "ANTHROPIC_VERSION": "2023-06-01",
    "MOCK_ANTHROPIC": "0",
    "DEMO_ENABLED": "1"
  }
}
